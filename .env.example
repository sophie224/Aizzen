# Aizzen local environment template (ARCHITECTURE.md §6.2).
#
# Copy to `.env` and fill in the real values:
#
#     cp .env.example .env
#
# `.env` is gitignored. NEVER commit real credentials, and never move a secret
# into a VITE_* variable — everything VITE_-prefixed is inlined into the client
# bundle and is readable by anyone who loads the page.

# ---------------------------------------------------------------------------
# Auth service (server-side only) — read by `npm run auth`
# ---------------------------------------------------------------------------

# Google OAuth client, from Google Cloud Console → APIs & Services →
# Credentials → OAuth 2.0 Client ID, of type "Web application".
GOOGLE_CLIENT_ID=your-google-client-id
# Server-side only. This value must never reach the browser.
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Origin the SPA is served from: used for CORS and the post-login redirect.
APP_ORIGIN=http://localhost:5173
# Public origin of the auth service itself: used to build the OAuth redirect
# URI, which is `${SERVICE_ORIGIN}/auth/google/callback`. Register that exact
# URI as an Authorized redirect URI on the Google client, and register
# APP_ORIGIN as an Authorized JavaScript origin.
SERVICE_ORIGIN=http://localhost:5170

# Signs the session cookie. Generate a long random value, e.g.
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production; a weak default is tolerated only outside it.
SESSION_SECRET=long-random-secret

# ---------------------------------------------------------------------------
# Optional auth-service overrides — defaults shown, uncomment to change
# ---------------------------------------------------------------------------

# PORT=5170
# SESSION_COOKIE_NAME=aizzen_session
# SESSION_MAX_AGE=28800
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MS=60000
# Phase 1 bridge: JSON snapshot of AppState used as the internal user
# directory. Defaults to fixtures/auth-directory.dev.json, regenerated from the
# app's seed users by `npm run auth:directory` (which `npm run auth` runs for
# you). Google sign-in only admits an ACTIVE user already listed there, and the
# session cookie carries that user's ID — so once you have added users through
# Administration, export the state from Administration → Data Tools and point
# this at the export instead. See server/config.ts.
# USER_DIRECTORY_PATH=fixtures/auth-directory.dev.json
# Points OIDC discovery at a local mock; tests set this themselves.
# OIDC_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration

# ---------------------------------------------------------------------------
# Frontend (VITE_*) — inlined into the client bundle, so PUBLIC by definition.
# Vite loads these from `.env` automatically for `npm run dev`.
# ---------------------------------------------------------------------------

VITE_AUTH_SERVICE_URL=http://localhost:5170

# VITE_STORAGE_ADAPTER=local
# VITE_API_BASE_URL=
# Set to `off` to hide the Control Registers navigation and unregister routes.
# VITE_FEATURE_CONTROL_REGISTERS=on
